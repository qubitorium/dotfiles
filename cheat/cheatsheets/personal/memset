# <string.h>
# Fills a block of memory with a constant byte value (converted to unsigned char).

SYNTAX:
  void *memset(void *s, int c, size_t n);

PARAMETERS:
  s : Pointer to the block of memory to fill.
  c : Value to set (passed as integer, converted to unsigned char).
  n : Number of bytes to be set to the value.

RETURN VALUE:
  Returns a pointer to the memory area s.

HPC & OPTIMIZATION NOTES:
  - Compilers often replace memset loops with optimized SIMD register stores (AVX/vectorized resets).
  - Setting non-zero integer values (e.g., trying to set an array of ints to 1) fills EVERY BYTE with 0x01, leading to 0x01010101 (16843009), not 1.
  - Use explicit zeroing memset(ptr, 0, bytes) to avoid garbage data in dynamically allocated structs.

COMPLETE CODE EXAMPLE:
  #include <stdio.h>
  #include <string.h>
  #include <stdlib.h>

  typedef struct {
      int id;
      double weights[64];
  } Node;

  Node n;
  memset(&n, 0, sizeof(Node)); // Fully zero-initializes struct and internal array

  int *arr = malloc(100 * sizeof(int));
  memset(arr, 0, 100 * sizeof(int)); // Zeroes memory allocation
  free(arr);
