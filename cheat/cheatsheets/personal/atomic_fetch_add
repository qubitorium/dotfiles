# <stdatomic.h> (C11 Standard)
# Atomically adds an operand to a lock-free atomic variable and returns original value.

SYNTAX:
  C atomic_fetch_add(volatile A *object, M operand);
  C atomic_fetch_add_explicit(volatile A *object, M operand, memory_order order);

MEMORY ORDERS (FOR WEAK REORDERING):
  memory_order_relaxed : Atomicity only (fastest).
  memory_order_acq_rel : Acquire-release barrier (ensures memory synchronization across cores).
  memory_order_seq_cst : Sequentially consistent (default lock-free hardware operation).

COMPLETE CODE EXAMPLE:
  #include <stdio.h>
  #include <stdatomic.h>
  #include <pthread.h>

  _Atomic int global_counter = 0;

  void *increment_work(void *arg) {
      for (int i = 0; i < 10000; i++) {
          // Hardware-level atomic increment without mutex lock overhead
          atomic_fetch_add_explicit(&global_counter, 1, memory_order_relaxed);
      }
      return NULL;
  }
