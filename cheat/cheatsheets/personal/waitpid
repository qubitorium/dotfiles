# <sys/wait.h> <sys/types.h>
# Suspends calling process execution until a specific child process changes state.

SYNTAX:
  pid_t waitpid(pid_t pid, int *wstatus, int options);

PID OPTIONS:
  >0 : Wait for specific child process ID.
  -1 : Wait for any child process (behaves like standard wait()).

OPTIONS BITMASK:
  WNOHANG : Non-blocking check. Return immediately if no child has exited.

MACROS FOR INSPECTING WSTATUS:
  WIFEXITED(status)   : True if child terminated normally.
  WEXITSTATUS(status) : Returns numerical exit code of child process.
  WIFSIGNALED(status) : True if child terminated due to uncaught signal.
  WTERMSIG(status)    : Returns signal number that caused process crash (e.g., SIGSEGV).

COMPLETE CODE EXAMPLE:
  #include <sys/wait.h>
  #include <unistd.h>
  #include <stdio.h>

  pid_t pid = fork();
  if (pid == 0) {
      // Child process execution
      return 42;
  } else {
      // Parent process wait
      int status;
      waitpid(pid, &status, 0);
      if (WIFEXITED(status)) {
          printf("Child exited with status: %d\n", WEXITSTATUS(status));
      }
  }
