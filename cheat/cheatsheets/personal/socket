# <sys/socket.h> <sys/types.h>
# Creates an endpoint for network communication and returns a socket file descriptor.

SYNTAX:
  int socket(int domain, int type, int protocol);

DOMAINS (ADDRESS FAMILIES):
  AF_INET  : IPv4 Internet protocols.
  AF_INET6 : IPv6 Internet protocols.
  AF_UNIX  : Local UNIX domain IPC sockets (fast local inter-process comms).

TYPES:
  SOCK_STREAM : Sequenced, reliable, two-way byte stream (TCP).
  SOCK_DGRAM  : Connectionless, unreliable datagrams (UDP).

PROTOCOL:
  0 : Auto-select default protocol for domain/type pair (e.g. IPPROTO_TCP).

COMPLETE CODE EXAMPLE:
  #include <sys/socket.h>
  #include <stdio.h>

  int fd = socket(AF_INET, SOCK_STREAM, 0);
  if (fd == -1) {
      perror("Socket creation failed");
  }
