# <stdlib.h>
# Sorts an array using an optimized quicksort implementation.

SYNTAX:
  void qsort(void *base, size_t nmemb, size_t size,
             int (*compar)(const void *, const void *));

PARAMETERS:
  base   : Pointer to the first element of array.
  nmemb  : Total number of elements in array.
  size   : Size in bytes of each element.
  compar : Function returning <0 (a < b), 0 (a == b), or >0 (a > b).

THREAD SAFETY:
  Thread-safe. For re-entrant sorting passing extra context parameters, use qsort_r().

COMPLETE CODE EXAMPLE:
  #include <stdio.h>
  #include <stdlib.h>

  int compare_ints(const void *a, const void *b) {
      int arg1 = *(const int *)a;
      int arg2 = *(const int *)b;
      return (arg1 > arg2) - (arg1 < arg2); // Branchless return
  }

  int main() {
      int data[] = {42, 12, 88, 3, 50, 1};
      size_t n = sizeof(data) / sizeof(data[0]);

      qsort(data, n, sizeof(int), compare_ints);

      for (size_t i = 0; i < n; i++) printf("%d ", data[i]);
      printf("\n");
  }
