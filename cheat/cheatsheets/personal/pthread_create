# <pthread.h> (Link flag: -lpthread)
# Creates a new concurrent thread execution context within the process.

SYNTAX:
  int pthread_create(pthread_t *thread, const pthread_attr_t *attr,
                     void *(*start_routine) (void *), void *arg);

PARAMETERS:
  thread        : Pointer to pthread_t variable storing the thread ID output.
  attr          : Attributes (stack size, scheduling policy, detach state). NULL for defaults.
  start_routine : Function pointer taking (void *) and returning (void *).
  arg           : Single pointer parameter passed to start_routine (pack structs for multiple args).

RETURN VALUE:
  Success: 0.
  Error  : Error code integer (EAGAIN, EINVAL, EPERM). Does NOT set errno.

THREAD ATTRIBUTES TUNING:
  pthread_attr_t attr;
  pthread_attr_init(&attr);
  pthread_attr_setstacksize(&attr, 1024 * 1024 * 16); // Set 16MB thread stack size
  pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_JOINABLE);

CPU AFFINITY (PINNING THREADS TO CORES):
  #define _GNU_SOURCE
  #include <sched.h>
  cpu_set_t cpuset;
  CPU_ZERO(&cpuset);
  CPU_SET(core_id, &cpuset);
  pthread_setaffinity_np(thread_id, sizeof(cpu_set_t), &cpuset);

COMPLETE CODE EXAMPLE:
  #include <pthread.h>
  #include <stdio.h>
  #include <stdlib.h>

  typedef struct {
      int thread_id;
      double *data;
  } thread_arg_t;

  void *worker(void *arg) {
      thread_arg_t *tdata = (thread_arg_t *)arg;
      printf("Worker thread %d processing\n", tdata->thread_id);
      pthread_exit(NULL);
  }

  int main() {
      pthread_t thread;
      thread_arg_t args = {.thread_id = 1, .data = NULL};

      if (pthread_create(&thread, NULL, worker, &args) != 0) {
          perror("Failed to create thread");
          return 1;
      }
      pthread_join(thread, NULL);
      return 0;
  }
