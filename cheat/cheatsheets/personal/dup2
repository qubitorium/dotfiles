# <unistd.h>
# Duplicates an open file descriptor onto a specified target descriptor (atomic replacement).

SYNTAX:
  int dup2(int oldfd, int newfd);

BEHAVIOR:
  - If newfd is open, it is silently closed first before duplication.
  - If oldfd is invalid, call fails and newfd is not closed.
  - Useful for I/O redirection (redirecting stdout/stderr to files or network sockets).

RETURN VALUE:
  Success: Returns newfd.
  Error  : Returns -1 and sets errno.

COMPLETE CODE EXAMPLE:
  #include <unistd.h>
  #include <fcntl.h>
  #include <stdio.h>

  int log_fd = open("output.log", O_WRONLY | O_CREAT | O_TRUNC, 0644);
  
  // Duplicate log_fd onto STDOUT (fd 1)
  dup2(log_fd, STDOUT_FILENO);
  close(log_fd);

  // All standard printf calls now write directly to output.log!
  printf("This output goes to output.log file instead of terminal.\n");
