# <pthread.h> (Link flag: -lpthread)
# Synchronizes a specified fixed number of threads at a execution checkpoint.

SYNTAX:
  int pthread_barrier_init(pthread_barrier_t *barrier, const pthread_barrierattr_t *attr, unsigned count);
  int pthread_barrier_wait(pthread_barrier_t *barrier);
  int pthread_barrier_destroy(pthread_barrier_t *barrier);

BEHAVIOR:
  - Every thread calling pthread_barrier_wait() blocks until exactly 'count' threads call it.
  - Once count threads reach the barrier, all threads are released simultaneously.
  - Exactly one arbitrary thread receives return value PTHREAD_BARRIER_SERIAL_THREAD; all others receive 0.

COMPLETE CODE EXAMPLE:
  #include <pthread.h>
  #include <stdio.h>

  #define THREAD_COUNT 4
  pthread_barrier_t barrier;

  void *step_worker(void *arg) {
      int tid = *(int *)arg;
      printf("Thread %d finished Phase 1\n", tid);

      // Block until all 4 threads reach this point
      pthread_barrier_wait(&barrier);

      printf("Thread %d starting Phase 2\n", tid);
      return NULL;
  }

  int main() {
      pthread_barrier_init(&barrier, NULL, THREAD_COUNT);
      // Spawn threads...
      pthread_barrier_destroy(&barrier);
  }
